<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootBox" alignment="CENTER" prefHeight="400.0" prefWidth="300.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.csc311_gui_basicslab.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label fx:id="countLabel" styleClass="rockButton" text="you rock 0 times" />
   <Button id="rockButton" mnemonicParsing="false" onAction="#onRockButtonClick" styleClass="rockButton" text="You Rock Button" />
    <Label fx:id="myNameLabel" styleClass="myNameLabel" text="My name is" />

    <Label id="nameLabel" fx:id="welcomeText" styleClass="nameLabel" text="Michael Hickey" />
    <Button id="nameLabel" onAction="#onHelloButtonClick" styleClass="nameLabel" text="WHATTS UPP!" />
</VBox>
